{
  "rules": {
    "bisca": {
      "classifica": {
        ".read": true,
        "$k": {
          ".write": "newData.exists() && (!root.child('nomi/' + $k).exists() || (auth != null && root.child('account/' + root.child('nomi/' + $k).val() + '/dispositivi/' + auth.uid).exists()))",
          ".validate": "newData.hasChildren(['nome','punti','data']) && newData.child('nome').isString() && newData.child('nome').val().length <= 20 && newData.child('punti').isNumber() && newData.child('punti').val() >= 0 && newData.child('punti').val() <= 10000000 && (!data.exists() || newData.child('punti').val() > data.child('punti').val())"
        }
      },
      "giocatori": {
        ".read": true,
        "$k": {
          "nome": {
            ".write": "(!root.child('nomi/' + $k).exists() || (auth != null && root.child('account/' + root.child('nomi/' + $k).val() + '/dispositivi/' + auth.uid).exists()))",
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "saldo": {
            ".write": "(!root.child('nomi/' + $k).exists() || (auth != null && root.child('account/' + root.child('nomi/' + $k).val() + '/dispositivi/' + auth.uid).exists()))",
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000000"
          },
          "ultimaPuntata": {
            ".write": "(!root.child('nomi/' + $k).exists() || (auth != null && root.child('account/' + root.child('nomi/' + $k).val() + '/dispositivi/' + auth.uid).exists()))",
            ".validate": "newData.isNumber()"
          },
          "aggiornato": {
            ".write": "(!root.child('nomi/' + $k).exists() || (auth != null && root.child('account/' + root.child('nomi/' + $k).val() + '/dispositivi/' + auth.uid).exists()))",
            ".validate": "newData.isString()"
          },
          "stats": {
            ".write": "(!root.child('nomi/' + $k).exists() || (auth != null && root.child('account/' + root.child('nomi/' + $k).val() + '/dispositivi/' + auth.uid).exists()))",
            "$s": {
              ".validate": "newData.isNumber()"
            }
          },
          "trofei": {
            "$t": {
              ".write": "newData.exists() && (!root.child('nomi/' + $k).exists() || (auth != null && root.child('account/' + root.child('nomi/' + $k).val() + '/dispositivi/' + auth.uid).exists()))",
              ".validate": "newData.isString() && newData.val().length <= 30"
            }
          }
        }
      },
      "classifiche": {
        ".read": true,
        "$t": {
          "$k": {
            ".write": "newData.exists() && (!root.child('nomi/' + $k).exists() || (auth != null && root.child('account/' + root.child('nomi/' + $k).val() + '/dispositivi/' + auth.uid).exists()))",
            ".validate": "($t === 't100' || $t === 't1000' || $t === 't10000' || $t === 't100000') && newData.hasChildren(['nome','punti','data']) && newData.child('nome').isString() && newData.child('nome').val().length <= 20 && newData.child('punti').isNumber() && newData.child('punti').val() >= 0 && newData.child('punti').val() <= 1000000000000 && (!data.exists() || newData.child('punti').val() > data.child('punti').val())"
          }
        }
      }
    },
    "corrimarf": {
      "classifica": {
        ".read": true,
        "$giocatore": {
          ".write": "newData.exists() && (!root.child('nomi/' + $giocatore).exists() || (auth != null && root.child('account/' + root.child('nomi/' + $giocatore).val() + '/dispositivi/' + auth.uid).exists()))",
          ".validate": "newData.hasChildren(['nome', 'punti']) && newData.child('nome').isString() && newData.child('nome').val().length > 0 && newData.child('nome').val().length <= 20 && newData.child('punti').isNumber() && newData.child('punti').val() >= 0 && newData.child('punti').val() <= 1000000 && (!data.exists() || newData.child('punti').val() > data.child('punti').val())"
        }
      },
      "giocatori": {
        ".read": true,
        "$g": {
          ".write": "newData.exists() && (!root.child('nomi/' + $g).exists() || (auth != null && root.child('account/' + root.child('nomi/' + $g).val() + '/dispositivi/' + auth.uid).exists()))",
          "nome": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20"
          },
          "canne": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000"
          },
          "record": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
          },
          "aggiornato": {
            ".validate": "newData.isString()"
          },
          "upg": {
            "$u": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10"
            }
          },
          "$altro": {
            ".validate": false
          }
        }
      },
      "missioni": {
        ".read": true,
        "$m": {
          ".write": "newData.exists() && (!root.child('nomi/' + $m).exists() || (auth != null && root.child('account/' + root.child('nomi/' + $m).val() + '/dispositivi/' + auth.uid).exists()))",
          "grado": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
          },
          "fatte": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
          },
          "aggiornato": {
            ".validate": "newData.isString()"
          },
          "slot": {
            "$i": {
              "id": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24"
              },
              "obj": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000"
              },
              "n": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000"
              },
              "fatta": {
                ".validate": "newData.isBoolean()"
              },
              "$altro": {
                ".validate": false
              }
            }
          },
          "$altro": {
            ".validate": false
          }
        }
      }
    },
    "account": {
      "$id": {
        ".read": "auth != null && data.child('dispositivi/' + auth.uid).exists()",
        ".write": "auth != null && (data.child('dispositivi/' + auth.uid).exists() || (!data.exists() && $id == auth.uid && newData.child('dispositivi/' + auth.uid).exists()))",
        "nome": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20"
        },
        "creato": {
          ".validate": "newData.isNumber()"
        },
        "dispositivi": {
          "$uid": {
            ".write": "auth != null && $uid == auth.uid && !data.exists() && newData.child('codice').isString() && root.child('abbinamenti/' + newData.child('codice').val() + '/account').val() == $id && root.child('abbinamenti/' + newData.child('codice').val() + '/creato').val() + 300000 > now",
            ".validate": "newData.hasChildren(['nome', 'data'])",
            "nome": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "data": {
              ".validate": "newData.isNumber()"
            },
            "codice": {
              ".validate": "newData.isString() && newData.val().length == 6"
            },
            "$altro": {
              ".validate": false
            }
          }
        },
        "$altro": {
          ".validate": false
        }
      }
    },
    "uid2account": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid && (!newData.exists() || root.child('account/' + newData.val() + '/dispositivi/' + auth.uid).exists())",
        ".validate": "newData.isString()"
      }
    },
    "nomi": {
      ".read": true,
      "$k": {
        ".write": "auth != null && (!data.exists() || root.child('account/' + data.val() + '/dispositivi/' + auth.uid).exists()) && (!newData.exists() || root.child('account/' + newData.val() + '/dispositivi/' + auth.uid).exists())",
        ".validate": "newData.isString()"
      }
    },
    "abbinamenti": {
      "$c": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.exists() && root.child('account/' + newData.child('account').val() + '/dispositivi/' + auth.uid).exists()) || (data.exists() && !newData.exists() && (root.child('account/' + data.child('account').val() + '/dispositivi/' + auth.uid).exists() || data.child('creato').val() + 300000 < now)))",
        ".validate": "$c.length == 6 && newData.hasChildren(['account', 'creato']) && newData.child('account').isString() && newData.child('creato').val() == now",
        "account": {
          ".validate": "newData.isString()"
        },
        "creato": {
          ".validate": "newData.isNumber()"
        },
        "$altro": {
          ".validate": false
        }
      }
    },
    "ggb": {
      "$id": {
        ".read": "auth != null && root.child('account/' + $id + '/dispositivi/' + auth.uid).exists()",
        ".write": "auth != null && root.child('account/' + $id + '/dispositivi/' + auth.uid).exists()",
        "saldo": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000"
        },
        "click": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000"
        },
        "guadagnati": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000000"
        },
        "spesi": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000000"
        },
        "creato": {
          ".validate": "newData.isNumber()"
        },
        "trofei": {
          "$t": {
            ".validate": "newData.isNumber() && $t.length <= 40"
          }
        },
        "sbloccati": {
          "$s": {
            ".validate": "newData.isNumber() && $s.length <= 40"
          }
        },
        "brani": {
          "$b": {
            ".validate": "newData.isNumber() && $b.length <= 80"
          }
        },
        "video": {
          "$v": {
            ".validate": "newData.isNumber() && $v.length <= 40"
          }
        },
        "$altro": {
          ".validate": false
        }
      }
    }
  }
}
